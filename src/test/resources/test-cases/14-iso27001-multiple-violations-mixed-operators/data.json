{
  "operands": {
    "org/commits-to-iso27001":     "true",
    "org/has-information-assets":  "true",
    "org/has-internet-access":     "false",
    "org/has-remote-access":       "false",
    "org/processes-personal-data": "true",
    "org/has-cloud-services":      "false",
    "org/has-web-applications":    "false",
    "org/has-mobile-devices":      "false",

    "access-control/policy-documented":          "true",
    "access-control/model":                      "rbac",
    "access-control/least-privilege-enforced":   "true",

    "information/classification-scheme":         "undefined",

    "authentication/password-min-length":              12,
    "authentication/failed-login-lockout-threshold":   5,

    "cryptography/symmetric-algorithm":   "des",
    "cryptography/tls-min-version":       1.0,
    "cryptography/key-management-policy": "undocumented"
  }
}