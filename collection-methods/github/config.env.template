# =============================================================================
# CRA Annex I — GitHub-based collection method
# Copy this file to your use case directory as config.env and fill in the values.
# =============================================================================

# --- GitHub identifiers ------------------------------------------------------
export OWNER=                         # GitHub organisation or user (e.g. home-assistant)
export REPO=                          # Repository name (e.g. core)
export ORG=                           # Organisation for org-level SECURITY.md check (same as OWNER for most projects)

# --- Assessment parameters ---------------------------------------------------
export ASSESSMENT_DATE=               # ISO date of the assessment (e.g. 2026-06-11)
export RELEASE_TAG=                   # Git tag of the release being assessed (e.g. 2026.6.1)
export COMMIT_SHA=                    # Auto-resolved from RELEASE_TAG by collect.py; override to pin explicitly
export RECENCY_THRESHOLD_DAYS=90      # Max days since last release to consider it recent
export ATTACK_SURFACE_THRESHOLD=500   # Integration count above which the attack surface is considered wide

# --- Repository paths (adapt these to match your project structure) ----------
# All paths are relative to the GitHub repository root.
export CONFIG_ENTRIES_PATH=           # Configuration entry point (e.g. src/config_entries.py)
export AUTH_PATH=                     # Authentication module entry point (e.g. src/auth/__init__.py)
export ONBOARDING_PATH=               # First-run setup component (e.g. src/components/onboarding)
export RECORDER_PATH=                 # Data persistence component (e.g. src/components/recorder)
export CLOUD_INTEGRATIONS_PATH=       # External service integrations directory (e.g. src/components)
export API_PATH=                      # Network API component (e.g. src/components/api)
export HTTP_PATH=                     # HTTP/TLS configuration module (e.g. src/components/http)
export ANALYTICS_PATH=                # Analytics/telemetry config file (e.g. src/components/analytics/__init__.py)
export LOGBOOK_PATH=                  # Security event logging component (e.g. src/components/logbook)
export COMPONENTS_DIR=                # Integration subdirectory root (e.g. src/components)
export CI_SECURITY_WORKFLOW=          # CI security scanning workflow (e.g. .github/workflows/codeql.yml)
export PYTHON_CONFIG=                 # Python project metadata file (e.g. pyproject.toml)

# --- GitHub token (optional but strongly recommended) ------------------------
# Without a token, GitHub API requests are rate-limited to 60/hour.
# With a token (no special scopes required), the limit is 5000/hour.
# export GITHUB_TOKEN=ghp_...
