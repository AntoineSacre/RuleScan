# =============================================================================
# CRA Annex I — Home Assistant Core use case
# Assessment date: 2026-06-11 / Product version: 2026.6.1
# =============================================================================
# To adapt this for another project, change the values below.
# All paths are relative to the GitHub repository root.
# =============================================================================

# --- GitHub identifiers ------------------------------------------------------
export OWNER=home-assistant
export REPO=core
export ORG=home-assistant         # organisation for org-level SECURITY.md check

# --- Assessment parameters ---------------------------------------------------
export ASSESSMENT_DATE=2026-06-11
export RECENCY_THRESHOLD_DAYS=90
export HIGH_CRITICAL_FRACTION_THRESHOLD=0.4
export ATTACK_SURFACE_THRESHOLD=500

# --- Repository paths (adapt these to match your project structure) ----------
export CONFIG_ENTRIES_PATH=homeassistant/config_entries.py
export AUTH_PATH=homeassistant/components/auth/__init__.py
export ONBOARDING_PATH=homeassistant/components/onboarding
export RECORDER_PATH=homeassistant/components/recorder
export CLOUD_INTEGRATIONS_PATH=homeassistant/components
export API_PATH=homeassistant/components/api
export HTTP_PATH=homeassistant/components/http
export ANALYTICS_PATH=homeassistant/components/analytics/__init__.py
export LOGBOOK_PATH=homeassistant/components/logbook
export COMPONENTS_DIR=homeassistant/components
export CI_SECURITY_WORKFLOW=.github/workflows/codeql.yml
export PYTHON_CONFIG=pyproject.toml

# --- GitHub token (optional but strongly recommended) ------------------------
# Without a token, GitHub API requests are rate-limited to 60/hour.
# With a token (no special scopes required), the limit is 5000/hour.
# export GITHUB_TOKEN=ghp_...
